# NITECHSPARK Mail API - Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=development
PORT=4000

# ---- Database ----
DATABASE_URL=postgresql://nitechspark:CHANGE_THIS_PASSWORD@localhost:5432/nitechspark_mail

# ---- Security (MUST change in production) ----
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHAR_RANDOM_STRING_FOR_PRODUCTION_USE_ONLY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_64_CHAR_RANDOM_STRING

# MUST be exactly 32 characters for AES-256
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_ENCRYPTION_KEY

# ---- SMTP (for sending email) ----
# Configure to point at your mail server
SMTP_HOST=mail.nitechspark.site
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=admin@nitechspark.site
SMTP_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM_NAME=NITECHSPARK Mail

# ---- IMAP (for reading email) ----
IMAP_HOST=mail.nitechspark.site
IMAP_PORT=993
IMAP_SECURE=true

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- CORS ----
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://mail.nitechspark.site

# ---- Rate Limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---- Attachments ----
MAX_ATTACHMENT_SIZE_MB=25
UPLOAD_DIR=/tmp/nitechspark-mail/attachments

# ---- Mail Sync ----
MAIL_SYNC_INTERVAL_MS=60000
MAIL_SYNC_BATCH_SIZE=50
