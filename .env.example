# NITECHSPARK Mail - Root Environment Template
# Copy to .env and fill in ALL values before running

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD

# ============================================
# SECURITY SECRETS (MUST CHANGE IN PRODUCTION)
# ============================================

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_SECURE_64_CHAR_RANDOM_SECRET_HERE

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET=GENERATE_ANOTHER_SECURE_64_CHAR_RANDOM_SECRET

# MUST be exactly 32 characters (AES-256)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=EXACTLY_32_CHARACTERS_HERE_123456

# ============================================
# MAIL SERVER CONFIGURATION
# ============================================
# Point these to your Postfix/Dovecot server

SMTP_HOST=mail.nitechspark.site
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=admin@nitechspark.site
SMTP_PASSWORD=CHANGE_THIS_MAIL_SERVER_PASSWORD
SMTP_FROM_NAME=NITECHSPARK Mail

IMAP_HOST=mail.nitechspark.site
IMAP_PORT=993
IMAP_SECURE=true

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
ALLOWED_ORIGINS=http://localhost:3000
